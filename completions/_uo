#compdef uo
# ═══════════════════════════════════════════════════════════════════════════════
#  Ubuntu Optimizer & Fixer — completions/_uo (zsh)
# ───────────────────────────────────────────────────────────────────────────────
#  zsh completion for the 'uo' command, mirroring completions/uo (bash):
#  value completion for the options that take an argument (--profile,
#  --cleanup, --github-remove, --install-targz) and flag completion for
#  everything else. install.sh copies this file into ~/.zfunc and adds that
#  directory to fpath; it loads automatically in new zsh terminals.
#
#  Project : ubuntu-optimizer — github.com/CheginiSoroush/ubuntu-optimizer
#  Author  : Soroush Chegini (CheginiSoroush)
#  License : MIT
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# _uo() — compute completions for the uo command
#
# _arguments drives the whole completion: every flag is a boolean action with
# its one-line help text from `uo --help`; the four argument-taking options
# declare their own value actions. Tracked app names are offered dynamically
# for --cleanup (both databases) and --github-remove (GitHub database only).
#
# Globals:   $words, $CURRENT (read by _arguments), compstate
# Arguments: none (standard zsh completion function contract)
# Returns:   0 — always
# ───────────────────────────────────────────────────────────────────────────────
_uo() {
    local -a opts
    opts=(
        '(-h --help)'{-h,--help}'[show help]'
        '(-V --version)'{-V,--version}'[show the version]'
        '(-y --yes)'{-y,--yes}'[auto-confirm all questions]'
        '--no-color[disable colored output]'
        '--no-log[do not log this run]'
        '--dry-run[preview what would change without changing anything]'
        '--config[use FILE as the config file instead of the default]:config file:_files'
        '--no-config[ignore every config file for this run]'
        '--config-show[print the effective configuration and exit]'
        '--config-example[print an annotated template config and exit]'
        '--lang[set the interface language (fa = Persian) and save it]:language:(fa en)'
        '--lang-show[print the effective interface language and its source]'
        '--no-cache[bypass the TTL cache for this run]'
        '--cache-clear[delete every cached entry]'
        '--cache-stats[show cache entries with their remaining TTL]'
        '--timer-install[install + enable a scheduled systemd timer]:period:(hourly daily weekly monthly)'
        '--timer-remove[disable and remove the update timer]'
        '--timer-status[show timer installation and next runs]'
        '--timer-log[show the last N journal lines of the runs]:lines:(10 20 50 100 200)'
        '--timer-preview[print the unit files an install would write]:period:(hourly daily weekly monthly)'
        '--timer-system[(with --timer-install/--timer-preview) system-wide units (sudo)]'
        '--timer-notify-only[(with --timer-install/--timer-preview) monitor mode — no updates applied]'
        '--timer-tick[internal: one monitor tick (report snapshot + notification)]'
        '--report[system status report (read-only)]'
        '--json[(with --report) machine-readable JSON output]'
        '--output[(with --report) write the report to FILE instead of stdout]:file:_files'
        '--append[(with --output) append instead of overwrite]'
        '--disk[disk usage analysis (read-only)]'
        '--disk-clean[disk cleanup]'
        '--disk-report[write the disk analysis as a self-contained HTML report]:output file:_files'
        '--git-ssh[GitHub SSH key setup wizard]'
        '--git-ssh-status[SSH key / GitHub authentication status]'
        '--doctor[health check & repair all installed/tracked apps]'
        '--boot[boot time analysis (total, slowest units, failed units — read-only)]'
        '--autostart[list the startup applications (XDG autostart)]'
        '--autostart-on[enable a startup application again]:name:_uo_autostart_names'
        '--autostart-off[disable a startup application]:name:_uo_autostart_names'
        '--health[one-shot system health snapshot (read-only)]'
        '--bigfiles[list the largest files under DIR (default HOME — read-only)]:directory:_files'
        '--ports[listening ports + which ones bind all interfaces (read-only)]'
        '--browser-clean[clean browser caches only — data never touched]'
        '--dns[switch the system DNS with one word]:preset:(shecan 403online radar electro cloudflare google quad9 adguard auto)'
        '--dns-list[show every DNS preset with its addresses (read-only)]'
        '--kernel-list[list the installed kernels — running one marked (read-only)]'
        '--kernel-clean[remove the old kernels (running + newest protected)]'
        '--swap[swap status: devices, size, swappiness (read-only)]'
        '--swap-on[create and enable a swapfile]:size in MB:(1024 2048 4096 8192)'
        '--swap-off[disable and delete the swapfile]'
        '--swappiness[tune vm.swappiness 1-100]:value:(1 10 20 30 60 100)'
        '--fzf[interactive fzf menu of the toolkit actions (needs fzf)]'
        '--github-install[install an app from the latest GitHub release]:repo (OWNER/REPO):app name (optional)'
        '--github-update[check and install updates for GitHub apps]'
        '--github-list[list tracked GitHub apps]'
        '--github-remove[fully remove a GitHub app]:tracked app:_uo_tracked_github'
        '--install-targz[install an app from a .tar.gz file]:tar.gz file:_files -g '"'"'*.tar.gz'"'"':app name (optional)'
        '--optimize[all network + system optimizations]'
        '--network[network optimizations (BBR, DNS, MTU, TCP)]'
        '--system[system and memory optimizations]'
        '--security[sudo timeout + polkit settings]'
        '--time[sync system time]'
        '--undo[reverse all optimizations this tool made]'
        '--profile[apply a curated preset]:profile:(laptop server gaming minimal)'
        '--fixnet[create the fixnet script]'
        '--fixnet-run[run fixnet (network repair)]'
        '--test[network tests (ping, DNS, speed)]'
        '--update[update all sources (apt, snap, flatpak, tar.gz, github)]'
        '--update-apt[apt only]'
        '--update-snap[snap only]'
        '--update-flatpak[flatpak only]'
        '--update-targz[check updates for tar.gz apps]'
        '--self-update[update the toolkit itself from the official GitHub repo]'
        '--no-update[skip the automatic startup update check for this run]'
        '--list-apps[list all apps from all sources]'
        '--cleanup[fully remove an app from any source]:tracked app:_uo_tracked_any'
        '--purge-data[(with --cleanup) also remove user data]'
        '--snap-clean[clean old snap revisions + unused flatpaks]'
        '--log[show the last log lines]'
        '--log-clear[delete the log file]'
    )
    _arguments -S "$opts[@]" && return 0
    return 1
}

# ───────────────────────────────────────────────────────────────────────────────
# _uo_autostart_names() — complete startup application names from the
# XDG autostart dirs (with and without the .desktop extension)
# ───────────────────────────────────────────────────────────────────────────────
_uo_autostart_names() {
    local -a names
    local adir afile abase
    for adir in "${XDG_CONFIG_HOME:-$HOME/.config}/autostart" /etc/xdg/autostart; do
        for afile in "$adir"/*.desktop(N); do
            abase="${afile##*/}"
            names+=("$abase" "${abase%.desktop}")
        done
    done
    _describe 'startup application' names
}

# ───────────────────────────────────────────────────────────────────────────────
# _uo_tracked_github() — complete names tracked in github.db
# ───────────────────────────────────────────────────────────────────────────────
_uo_tracked_github() {
    local -a names
    names=($(awk -F'|' '{print $1}' "$HOME/.local/share/ubuntu-optimizer/github.db" 2>/dev/null))
    _describe 'tracked GitHub app' names
}

# ───────────────────────────────────────────────────────────────────────────────
# _uo_tracked_any() — complete names tracked in github.db + apps.db
# ───────────────────────────────────────────────────────────────────────────────
_uo_tracked_any() {
    local -a names
    names=($( { awk -F'|' '{print $1}' "$HOME/.local/share/ubuntu-optimizer/github.db" 2>/dev/null
                 awk -F'|' '{print $1}' "$HOME/.local/share/ubuntu-optimizer/apps.db" 2>/dev/null; } | sort -u))
    _describe 'tracked app' names
}

_uo "$@"
