# shellcheck shell=bash
# ═══════════════════════════════════════════════════════════════════════════════
#  Ubuntu Optimizer & Fixer — completions/uo
# ───────────────────────────────────────────────────────────────────────────────
#  Bash completion for the 'uo' command: value completion for the options that
#  take an argument (--cleanup, --github-remove) and flag completion for
#  everything else. Copied by install.sh into the user's bash-completion
#  directory and loaded automatically in new terminals.
#
#  Project : ubuntu-optimizer — github.com/CheginiSoroush/ubuntu-optimizer
#  Author  : Soroush Chegini (CheginiSoroush)
#  License : MIT
# ═══════════════════════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────────────────────
# _uo() — compute completions for the uo command
#
# Value completion first: --cleanup offers tracked app names from both
# databases (github.db + apps.db), --github-remove only names from
# github.db. Otherwise the option list is offered while a flag is being
# typed or directly after the command word.
#
# Globals:   COMP_WORDS, COMP_CWORD (read), COMPREPLY (written)
# Arguments: none
# Returns:   0 — always
# ───────────────────────────────────────────────────────────────────────────────
_uo() {
    local cur prev
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    # Value completion for options that take an argument
    case "$prev" in
        --profile)
            mapfile -t COMPREPLY < <(compgen -W "laptop server gaming minimal" -- "$cur")
            return 0
            ;;
        --timer-install|--timer-preview)
            mapfile -t COMPREPLY < <(compgen -W "hourly daily weekly monthly" -- "$cur")
            return 0
            ;;
        --timer-log)
            mapfile -t COMPREPLY < <(compgen -W "10 20 50 100 200" -- "$cur")
            return 0
            ;;
        --lang)
            mapfile -t COMPREPLY < <(compgen -W "fa en" -- "$cur")
            return 0
            ;;
        --output)
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            return 0
            ;;
        --disk-report)
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            return 0
            ;;
        --config)
            mapfile -t COMPREPLY < <(compgen -f -- "$cur")
            return 0
            ;;
        --cleanup)
            # Tracked app names from both databases (GitHub + tar.gz registry)
            local names
            names=$( {
                awk -F'|' '{print $1}' "$HOME/.local/share/ubuntu-optimizer/github.db" 2>/dev/null
                awk -F'|' '{print $1}' "$HOME/.local/share/ubuntu-optimizer/apps.db" 2>/dev/null
            } | sort -u )
            mapfile -t COMPREPLY < <(compgen -W "$names" -- "$cur")
            return 0
            ;;
        --github-remove)
            local names
            names=$(awk -F'|' '{print $1}' "$HOME/.local/share/ubuntu-optimizer/github.db" 2>/dev/null | sort -u)
            mapfile -t COMPREPLY < <(compgen -W "$names" -- "$cur")
            return 0
            ;;
        --autostart-on|--autostart-off)
            # Startup application names from the XDG autostart dirs —
            # both with and without the .desktop extension
            local -a anames=()
            local adir afile abase
            for adir in "${XDG_CONFIG_HOME:-$HOME/.config}/autostart" /etc/xdg/autostart; do
                for afile in "$adir"/*.desktop; do
                    if [ -f "$afile" ]; then
                        abase="${afile##*/}"
                        anames+=("$abase" "${abase%.desktop}")
                    fi
                done
            done
            mapfile -t COMPREPLY < <(compgen -W "${anames[*]}" -- "$cur")
            return 0
            ;;
        --bigfiles)
            # optional directory argument — complete directories only
            mapfile -t COMPREPLY < <(compgen -d -- "$cur")
            return 0
            ;;
        --dns)
            mapfile -t COMPREPLY < <(compgen -W "shecan 403online radar electro cloudflare google quad9 adguard auto" -- "$cur")
            return 0
            ;;
        --swap-on)
            mapfile -t COMPREPLY < <(compgen -W "1024 2048 4096 8192" -- "$cur")
            return 0
            ;;
        --swappiness)
            mapfile -t COMPREPLY < <(compgen -W "1 10 20 30 60 100" -- "$cur")
            return 0
            ;;
    esac

    # Option completion — while typing a flag, or right after the command
    local opts="
        -h --help -V --version -y --yes --no-color --no-log --dry-run
        --config --no-config --config-show --config-example
        --lang --lang-show
        --no-cache --cache-clear --cache-stats
        --timer-install --timer-remove --timer-status --timer-log
        --timer-preview --timer-system --timer-notify-only --timer-tick
        --report --json --output --append --git-ssh --git-ssh-status --doctor
        --boot --autostart --autostart-on --autostart-off
        --dns --dns-list --kernel-list --kernel-clean
        --swap --swap-on --swap-off --swappiness
        --splash --fix-splash
        --health --bigfiles --ports --browser-clean --fzf
        --disk --disk-clean --disk-report
        --github-install --github-update --github-list --github-remove
        --install-targz
        --optimize --network --system --security --time --undo --profile
        --self-update --no-update
        --fixnet --fixnet-run --test
        --update --update-apt --update-snap --update-flatpak --update-targz
        --list-apps --cleanup --purge-data --snap-clean
        --log --log-clear
    "
    if [[ "$cur" == -* ]] || { [ -z "$cur" ] && [ "$COMP_CWORD" -eq 1 ]; }; then
        mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
        return 0
    fi

    return 0
}

# Register the handler for 'uo'; -o default falls back to file completion
# when no option matches.
complete -o default -F _uo uo
